    { "key": "client_secret_catalogo", "value": "PON_AQUI_TU_SECRET" },
    { "key": "client_secret_usuarios", "value": "PON_AQUI_TU_SECRET" },
    { "key": "client_secret_notificacion", "value": "PON_AQUI_TU_SECRET" },
    { "key": "username", "value": "librarian1" },
